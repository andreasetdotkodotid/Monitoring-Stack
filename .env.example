# Monitoring Stack Environment

TZ=Asia/Jakarta

PROMETHEUS_RETENTION=180d
PROMETHEUS_RETENTION_SIZE=20GB

GRAFANA_DOMAIN=monitoring.example.com
GRAFANA_ROOT_URL=https://monitoring.example.com/grafana/
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-now
GRAFANA_SECRET_KEY=change-me-with-long-random-secret

GOOGLE_CLIENT_ID=change-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change-me
GOOGLE_ALLOWED_DOMAINS=example.com
GOOGLE_ALLOWED_GROUPS=

SMTP_FROM=monitoring@example.com
SMTP_SMARTHOST=smtp.example.com:587
SMTP_AUTH_USERNAME=monitoring@example.com
SMTP_AUTH_PASSWORD=change-me
SMTP_TO=sre@example.com
SMTP_REQUIRE_TLS=true

ALERTMANAGER_EXTERNAL_URL=https://monitoring.example.com/alertmanager/
KARMA_EXTERNAL_URI=https://monitoring.example.com/karma/
